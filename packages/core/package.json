{
  "name": "@p2prpc/core",
  "version": "0.2.0",
  "description": "Type-safe peer-to-peer tRPC and striped file transfer over Iroh QUIC",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arduano/p2prpc.git",
    "directory": "packages/core"
  },
  "homepage": "https://arduano.github.io/p2prpc/",
  "bugs": {
    "url": "https://github.com/arduano/p2prpc/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": null
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": null
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": null
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/node.integration.test.ts",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@momics/iroh-http-node": "0.6.0",
    "@momics/iroh-http-shared": "0.6.1",
    "@napi-rs/blake-hash": "1.3.6",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "jose": "6.2.10",
    "msgpackr": "2.0.5",
    "superjson": "2.2.6"
  },
  "peerDependencies": {
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "keywords": [
    "p2p",
    "rpc",
    "trpc",
    "iroh",
    "quic",
    "file-transfer",
    "typescript"
  ]
}
